# Copy to .env and fill in. Every variable here is validated at boot by
# server/src/config/env.ts -- the process exits rather than starting in a
# half-configured state.

# Postgres connection string. Postgres is used for local development as well as
# deployment (see ASSUMPTIONS.md #33) -- a free hosted tier such as Neon works
# without installing anything locally.
DATABASE_URL=postgresql://user:password@localhost:5432/stockfolio

# Signing secret for JWTs. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional. Defaults below are applied when the variable is absent.
PORT=3000
NODE_ENV=development

# Only needed if the frontend is ever split onto its own host; unused while the
# app is deployed as a single process serving both API and static files.
# CORS_ORIGIN=http://localhost:5173

# No STOCK_API_KEY entry: the market data source is Yahoo Finance unofficial
# endpoints, which are unauthenticated (ASSUMPTIONS.md #12). If the provider is
# ever swapped for a licensed vendor, its key belongs here.
